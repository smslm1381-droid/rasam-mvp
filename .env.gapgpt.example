# تنظیمات فقط برای test.py؛ کلید GapGPT با کلید OpenRouter متفاوت است.
# از این فایل با نام .env.gapgpt کپی بگیرید و فقط در کپی کلید را قرار دهید.
# نشانی CDN رسمی پس از آزمون اتصال و مدل Gemma از فهرست قیمت API انتخاب شده‌اند.
RASAM_LLM_BASE_URL=https://api.gapapi.com/v1
RASAM_LLM_MODEL=gemma-3-27b-it
RASAM_LLM_API_KEY=
RASAM_LLM_MAX_TOKENS=1024
