# نمونه‌ی فایل محیطی رصام.
# این فایل کامیت می‌شود؛ کپی‌اش با نام `.env` هرگز کامیت نمی‌شود.
#
#   Copy-Item .env.example .env
#
# همه‌ی متغیرها پیشوند RASAM_ دارند.

# --- دیتابیس مشتری ---
# قاعده‌ی امنیتی ۲: این کاربر باید فقط-خواندنی باشد.
# کاربر `rasam_ro` در قدم ۲ ساخته می‌شود.
RASAM_MONGO_URI=mongodb://rasam_ro:CHANGE_ME@localhost:27017/solar_telemetry
RASAM_MONGO_DB=solar_telemetry
RASAM_CUSTOMER=demo

# --- اتصال مدیر (فقط برای seed) ---
# تنها اتصال نویسنده‌ی پروژه. برنامه هرگز از آن استفاده نمی‌کند و روی سرور
# اصلاً لازم نیست وجود داشته باشد.
RASAM_MONGO_ADMIN_URI=mongodb://root:CHANGE_ME_ROOT@localhost:27017/?authSource=admin

# --- کاربر ریشه‌ی کانتینر مونگو ---
# اینها را خودِ `docker compose` می‌خواند (بدون پیشوند RASAM_). باید با نام
# کاربری و رمزِ داخل RASAM_MONGO_ADMIN_URI بالا یکی باشند.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT

# --- داده‌ی خام ---
# CSVها بیرون از مخزن‌اند (حدود ۱۵ مگابایت). مسیر نسبی نسبت به ریشه‌ی پروژه
# معنا می‌شود. اسکریپت seed در قدم ۲ از اینجا می‌خواند.
RASAM_CSV_DIR=../data/raw

# --- سقف‌های اجرای کوئری (گارد، قدم ۴) ---
# سقف زمان اجرای یک کوئری. دفاع در برابر کوئری‌ای که منابع سرور را می‌بلعد.
RASAM_QUERY_TIMEOUT_MS=60000
# سقف تعداد رکورد برگشتی. بدون این سقف API نباید اجرا شود.
RASAM_MAX_ROWS=1000

# --- سقف‌های ورودی و پرامپت ---
# سوال بلند رد می‌شود تا مدل متن ناقص دریافت نکند.
RASAM_MAX_QUESTION_CHARS=2000
# نتیجه‌ی دیتابیس برای خلاصه‌سازی تا این تعداد ردیف و کاراکتر فرستاده می‌شود.
RASAM_MAX_RESULT_ROWS=30
RASAM_MAX_RESULT_CHARS=4000
# تعداد کل تلاش تولید کوئری، شامل تلاش اول و ترمیم‌ها.
RASAM_MAX_ATTEMPTS=2

# --- سرویس مدل زبانی ---
# با عوض‌کردن فقط BASE_URL می‌شود به مدل محلی (Ollama / vLLM) رفت — برای
# مشتری‌ای که داده‌اش نباید از سرورش خارج شود.
RASAM_LLM_API_KEY=
RASAM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RASAM_LLM_MODEL=gemini-3-flash-preview

# --- API ---
# این مقدار را با یک کلید قوی عوض کنید و هرگز در مخزن commit نکنید.
RASAM_API_KEY=CHANGE_ME_API_KEY

# --- تنظیم‌های اختیاری مدل (پیش‌فرض دارند) ---
# سقف انتظار برای جواب مدل. جواب‌های واقعی ۱ تا ۳ ثانیه‌اند؛ این سقف برای
# وقتی است که سرویس یا شبکه گیر کند. بدون آن، پیش‌فرض کتابخانه ۱۰ دقیقه است.
RASAM_LLM_TIMEOUT_MS=90000
# سقف توکن خروجی اجباری است: بدون آن بعضی سرویس‌ها کل پنجره‌ی خروجی مدل را
# هزینه‌ی احتمالی می‌سنجند و خطای ۴۰۲ می‌دهند.
RASAM_LLM_MAX_TOKENS=1024
# برای تولید کوئری، خروجی قطعی از خلاقیت مهم‌تر است.
RASAM_LLM_TEMPERATURE=0.1
# چقدر مدل پیش از جواب‌دادن «فکر» کند.
#
#   none                  خاموش — پیش‌فرض ما
#   low | medium | high   روشن، با شدت‌های مختلف
#   unset                 این پارامتر اصلاً فرستاده نشود (پیش‌فرض خود سرویس)
#
# چرا پیش‌فرض خاموش است: برای تولید کوئری، فکرکردن فقط کند و گران است. روی
# Gemini 3 Flash اندازه‌گیری شد — ۳٫۴ ثانیه با فکرکردن در برابر ۱٫۲ ثانیه
# بدون آن، با همان جواب درست.
#
# روشن‌کردنش در آینده فقط عوض‌کردن همین یک کلمه است.
# اگر روزی سرویسی این پارامتر را نشناسد و خطای ۴۰۰ بدهد، `unset` بگذارید.
RASAM_LLM_REASONING_EFFORT=none

# چاپ پرامپت کامل و پاسخ خام مدل. مهم‌ترین ابزار عیب‌یابی پروژه (قدم ۵).
RASAM_VERBOSE=0
